# For `npm run dev` on YOUR OWN machine only (the editor and the deployed site
# get these from the platform). Copy to .env, which git ignores — never commit it.

# The community's own site origin: the pages read its public API.
EZY_SITE_URL=https://your-community.example.com

# Optional: a Site Database to develop against — the Preview Database's
# connection string from the Site Database panel. Leave empty and the Site API
# answers that the Site Database is not enabled.
DATABASE_URL=

# Optional: a Community Key, for the members directory (`/site-api/members`).
EZY_COMMUNITY_KEY=

# Optional: `1` runs the editor Preview's stand-in signed-in member, to try
# member and admin screens without a session. Never set on a live site.
EZY_PREVIEW=
