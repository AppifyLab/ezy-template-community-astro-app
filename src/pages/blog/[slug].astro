---
/**
 * One post, as an article: title, subtitle, byline, cover, body, a call to
 * join, and related posts. Rendered on the server from
 * `GET /site-api/posts/:slug` (HTML already sanitized there). An unknown slug
 * answers a real 404.
 */
import NotFound from '../../components/NotFound.astro';
import PostRow from '../../components/PostRow.astro';
import Base from '../../layouts/Base.astro';
import {formatDate, initials, preview, readingMinutes} from '../../lib/format';
import type {Post, PostSummary} from '../../lib/types';
import {read} from '../../server/backend';
import {pageContext} from '../../server/page';

const slug = Astro.params.slug ?? '';
const {api, site, viewer} = await pageContext(Astro.request, Astro.response);
const [found, related] = await Promise.all([
  read<{post: Post}>(api.posts[':slug'].$get({param: {slug}})),
  read<{posts: PostSummary[]}>(api.posts[':slug'].related.$get({param: {slug}})),
]);
const post = found?.post ?? null;
if (!post) Astro.response.status = 404;
const name = site?.name ?? 'Community';
---

{
  post ? (
    <Base site={site} viewer={viewer} title={post.title} description={preview(post.excerpt, post.content)} image={post.coverUrl}>
      <main class="pub">
        <article class="article">
          <header>
            <h1>{post.title}</h1>
            {post.excerpt && <p class="article-subtitle">{post.excerpt}</p>}
            <div class="article-byline">
              {post.authors.map(author =>
                author.avatar ? (
                  <img src={author.avatar} alt="" width="36" height="36" />
                ) : (
                  <span class="avatar-fallback" aria-hidden="true">{initials(author.name)}</span>
                )
              )}
              <div>
                <strong>{post.authors.map(author => author.name).join(', ') || name}</strong>
                <span class="muted small">
                  {post.publishedAt && formatDate(post.publishedAt)} · {readingMinutes(post.content)} min read
                </span>
              </div>
            </div>
          </header>

          {post.coverUrl && <img class="article-cover" src={post.coverUrl} alt="" />}

          <div class="prose" set:html={post.content} />

          {(post.categories.length > 0 || post.tags.length > 0) && (
            <p class="terms">
              {post.categories.map(category => <span class="chip">{category.name}</span>)}
              {post.tags.map(tag => <span class="chip chip-tag">#{tag.name}</span>)}
            </p>
          )}
        </article>

        {viewer.state !== 'member' && (
          <aside class="article-cta">
            <h2>Enjoyed this? Join {name}</h2>
            <p class="muted">Get the conversation, the events and every new post.</p>
            <a class="button" href={`/register?redirectTo=${encodeURIComponent(Astro.url.pathname)}`}>Join for free</a>
          </aside>
        )}

        {(related?.posts.length ?? 0) > 0 && (
          <section class="pub-related">
            <h2>Keep reading</h2>
            <div class="pub-list">{related!.posts.map(item => <PostRow post={item} />)}</div>
          </section>
        )}

        <p><a href="/blog">← All posts</a></p>
      </main>
    </Base>
  ) : (
    <Base site={site} viewer={viewer} title="Page not found">
      <NotFound site={site} />
    </Base>
  )
}
